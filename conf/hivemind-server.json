{
  "grpc": {
    "bind-address": "0.0.0.0",
    "bind-port": 11788,
    "max-msg-size": 4194304
  },
  "serving": {
    "mode": "debug",
    "healthz": true,
    "middlewares": [],
    "bind-address": "0.0.0.0",
    "bind-port": 11789
  },
  "models": {
    "mode": "merge",
    "default-provider": "deepseek",
    "default-model": "deepseek-chat",
    "providers": {
      "deepseek": {
        "base-url": "https://api.deepseek.com/v1",
        "api-key": "${DEEPSEEK_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek V3",
            "reasoning": false,
            "input": ["text"],
            "context-window": 65536,
            "max-tokens": 8192,
            "cost": { "input": 0.27, "output": 1.1, "cache-read": 0.07, "cache-write": 0 }
          },
          {
            "id": "deepseek-reasoner",
            "name": "DeepSeek R1",
            "reasoning": true,
            "input": ["text"],
            "context-window": 65536,
            "max-tokens": 8192,
            "cost": { "input": 0.55, "output": 2.19, "cache-read": 0.14, "cache-write": 0 }
          }
        ]
      }
    }
  },
  "plugins": {
    "enabled": true,
    "slots": {
      "memory": "memory-core"
    },
    "entries": {
      "memory-core": {
        "config": {
          "enabled": true,
          "workspace_dir": ".echoryn/workspace",
          "store": {
            "driver": "sqlite",
            "path": ".echoryn/workspace/memory/index.db"
          },
          "embedding_provider": "ollama",
          "embedding_model": "nomic-embed-text"
        }
      },
      "diagnostics": {
        "config": {
          "enabled": true
        }
      },
      "llm-task": {
        "config": {
          "enabled": true
        }
      },
      "channel-feishu": {
        "config": {
          "enabled": true,
          "app_id": "${FEISHU_APP_ID}",
          "app_secret": "${FEISHU_APP_SECRET}",
          "connection_mode": "websocket",
          "domain": "feishu"
        }
      },
      "web-search": {
        "config": {
          "enabled": true,
          "provider": "gemini",
          "timeout_seconds": 30,
          "gemini": {
            "api_key": "${GEMINI_API_KEY}",
            "model": "gemini-2.5-flash"
          }
        }
      }
    }
  }
}
